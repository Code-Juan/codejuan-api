#server
PORT=3000
NODE_ENV=production

#allowed origins (comma-separated)
ALLOWED_ORIGINS=https://codejuan.com,https://services.codejuan.com

#resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx
DEFAULT_FROM_EMAIL=noreply@codejuan.com
NOTIFICATION_EMAIL=contact@codejuan.com

#stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

#postgresql
DATABASE_URL=postgresql://codejuan_api:your_password@localhost:5432/codejuan

#file uploads
UPLOAD_DIR=/var/www/uploads
MAX_FILE_SIZE=10485760
