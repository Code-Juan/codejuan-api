#server
PORT=3000
NODE_ENV=production

#allowed origins (comma-separated)
ALLOWED_ORIGINS=https://codejuan.com,https://services.codejuan.com

#resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx
DEFAULT_FROM_EMAIL=noreply@codejuan.com
NOTIFICATION_EMAIL=contact@codejuan.com
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
FORWARD_TO_EMAIL=you@yahoo.com
#comma-separated addresses to forward (default: juan@codejuan.com)
#INBOUND_FORWARD_ADDRESSES=juan@codejuan.com,contact@codejuan.com

#stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

#postgresql
DATABASE_URL=postgresql://codejuan_api:your_password@localhost:5432/codejuan

#file uploads
UPLOAD_DIR=/var/www/uploads
MAX_FILE_SIZE=10485760

#google drive (optional - when set, uploads go to Drive instead of local disk)
#GOOGLE_DRIVE_FOLDER_ID=your_folder_id
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
